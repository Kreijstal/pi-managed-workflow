{
  "name": "pi-managed-workflow",
  "version": "0.0.1",
  "description": "Persistent managed agents and spec-driven multi-agent workflows for Pi",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kreijstal/pi-managed-workflow.git"
  },
  "homepage": "https://github.com/Kreijstal/pi-managed-workflow#readme",
  "bugs": {
    "url": "https://github.com/Kreijstal/pi-managed-workflow/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "workflow",
    "multi-agent",
    "managed-agents",
    "persistent-sessions"
  ],
  "files": [
    "*.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test *.test.ts",
    "smoke": "pi --no-session --no-extensions -e ./index.ts -p /agents",
    "check": "npm run typecheck && npm test && npm run smoke"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@types/node": "26.1.2",
    "typebox": "1.3.26",
    "typescript": "5.9.3"
  }
}
